resources:
  jobs:
    case_bcb_pipeline:
      name: case_bcb_pipeline
      description: >-
        Pipeline medalhao das series SELIC (11) e IPCA (433) do SGS/BCB.

        Bronze (Auto Loader) -> Silver (MERGE idempotente) -> Gold (juro real
        mensal).

        Codigo em https://github.com/herberthalvees/case-bcb
      schedule:
        quartz_cron_expression: 55 5 9 * * ?
        timezone_id: America/Sao_Paulo
        pause_status: UNPAUSED
      tasks:
        - task_key: bronze
          notebook_task:
            notebook_path: notebooks/01_bronze
            source: GIT
          min_retry_interval_millis: 900000
          disable_auto_optimization: true
        - task_key: silver
          depends_on:
            - task_key: bronze
          notebook_task:
            notebook_path: notebooks/02_silver
            source: GIT
          min_retry_interval_millis: 900000
          disable_auto_optimization: true
        - task_key: gold
          depends_on:
            - task_key: silver
          notebook_task:
            notebook_path: notebooks/03_gold
            source: GIT
          min_retry_interval_millis: 900000
          disable_auto_optimization: true
      git_source:
        git_url: https://github.com/herberthalvees/case-bcb.git
        git_provider: gitHub
        git_branch: main
      queue:
        enabled: true
      performance_target: PERFORMANCE_OPTIMIZED
